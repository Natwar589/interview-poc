# Copy to .env and fill in. Never commit .env.

# Streaming speech-to-text (https://console.deepgram.com - free credits on signup)
DEEPGRAM_API_KEY=

# Which LLM writes the answers: gemini | anthropic
LLM_PROVIDER=gemini

# Gemini (https://aistudio.google.com/apikey - free tier)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
# LOW | MEDIUM | HIGH (some models also take MINIMAL). Lower = faster first token.
GEMINI_THINKING=LOW
# Used when the main model is overloaded (503/429) before any answer text arrives.
GEMINI_FALLBACK_MODEL=gemini-2.5-flash

# Anthropic (https://console.anthropic.com) - only needed when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# claude-haiku-5-5 is the faster/cheaper option if time-to-first-token is above budget.
ANSWER_MODEL=claude-opus-5-5
ANSWER_EFFORT=low

# Optional overrides
PORT=3000
DEEPGRAM_MODEL=nova-3
# Silence (ms) before Deepgram marks speech_final. Lower = faster, but more mid-sentence cuts.
DEEPGRAM_ENDPOINTING_MS=300
# Quiet (ms) after speech before our own VAD makes Deepgram finalize. 400 was faster but
# sometimes clipped the first word of the next sentence; 600 caught every test question.
VAD_SILENCE_MS=600
# Extra wait (ms) for utterances that look like a question but might not be finished.
QUESTION_HOLD_MS=900
# 1 = canned streamed answers, no LLM key needed (UI testing)
MOCK_LLM=0
