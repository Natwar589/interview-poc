# Copy to .env and fill in. Never commit .env.

# Sign-in by email code. Visitors give their name and email; the server posts
# {event: "login_code", name, email, code, subject, body, html, expiresInMinutes} to the
# webhook, whose flow emails it. Uses LOGIN_WEBHOOK_URL, else VISIT_WEBHOOK_URL (below).
# With neither set, sign-in is off (only safe when the app is reachable by you alone).
LOGIN_WEBHOOK_URL=
# Signs session cookies so sign-ins survive restarts; any long random string.
SESSION_SECRET=
# Optional: only these emails can sign in (comma separated). Empty = anyone.
ALLOWED_EMAILS=

# Streaming speech-to-text (https://console.deepgram.com - free credits on signup)
DEEPGRAM_API_KEY=

# Which LLM writes the answers, in fallback order. If one fails before any text appears
# (all keys out of quota, overloaded, bad keys), the question goes to the next.
# Providers without keys are left out. A single name (e.g. groq) disables fallback.
LLM_PROVIDER=gemini,anthropic,groq

# Key rotation: every provider takes several keys, comma separated, in *_API_KEYS
# (the single *_API_KEY still works and is added to the list). Requests go round-robin.
# A rate-limited key (429) sits out for as long as the provider asks (Retry-After or
# Gemini's retryDelay; 60 s by default; an hour for a daily quota), a rejected key
# (401/403) for an hour, and the request retries on the next key before any text is shown.

# Gemini (https://aistudio.google.com/apikey - free tier, quota is per key/project)
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-2.5-flash-lite
# LOW | MEDIUM | HIGH (some models also take MINIMAL). Lower = faster first token.
GEMINI_THINKING=LOW
# Used when the main model is overloaded (503/429) before any answer text arrives.
GEMINI_FALLBACK_MODEL=gemini-2.5-flash

# Anthropic (https://console.anthropic.com) - only needed when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEYS=
# claude-haiku-5-5 is the faster/cheaper option if time-to-first-token is above budget.
ANSWER_MODEL=claude-opus-5-5
ANSWER_EFFORT=low

# Groq (https://console.groq.com/keys - free tier) - only needed when LLM_PROVIDER=groq
GROQ_API_KEYS=
GROQ_MODEL=openai/gpt-oss-120b
# Reasoning level: gpt-oss low|medium|high, qwen none|default. Lower = faster first token.
# Faster alternative: GROQ_MODEL=qwen/qwen3.8-27b (reasoning none).
GROQ_REASONING=low

# Optional overrides
PORT=3000
DEEPGRAM_MODEL=nova-3
# Accent-tuned English: en (general), en-IN (Indian English), en-GB, en-AU, en-US.
DEEPGRAM_LANGUAGE=en
# Silence (ms) before Deepgram marks speech_final. Lower = faster, but more mid-sentence cuts.
DEEPGRAM_ENDPOINTING_MS=300
# Quiet (ms) after speech before our own VAD makes Deepgram finalize. 400 was faster but
# sometimes clipped the first word of the next sentence; 600 caught every test question.
VAD_SILENCE_MS=600
# Extra wait (ms) for utterances that look like a question but might not be finished.
QUESTION_HOLD_MS=900
# 1 = canned streamed answers, no LLM key needed (UI testing)
MOCK_LLM=0
# Optional: POST a JSON event {event: "visit", visitorId, name, email, at, path, userAgent,
# referrer} here the first time each browser signs in (or opens the site, with sign-in off).
VISIT_WEBHOOK_URL=
